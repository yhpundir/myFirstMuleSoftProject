"phno":payload.phoneNumber}]]]></db:input-parameters>
		</db:insert>
		<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "message": "created successfully"
} ]]></ee:set-payload>
            </ee:message>
        </ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="1141ac78-7103-4927-8a67-d22f828978fe" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;  "message": "created successfully"&#10;}]'/>
    </flow>
</mule>
